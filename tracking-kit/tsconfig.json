{
  "//": "Só pra conferir o kit isolado: npx tsc -p tracking-kit --noEmit. No seu projeto, o kit usa o tsconfig dele.",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "target": "es2017",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "skipLibCheck": true,
    "baseUrl": "..",
    "paths": { "@/tracking-kit/*": ["./tracking-kit/*"] }
  },
  "include": ["**/*.ts", "**/*.tsx"]
}
